	(text "Pulling ~{SEN} low ensures\npredictable I2C address\nfor the Si4705"
		(exclude_from_sim no)
		(at 164.338 104.902 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9aca9232-2fe3-43fa-803d-79560350170c")
	)
	(text "Fwd. voltage on LED 2.0V,\ndesired operating current\naround 1mA. 1.5k resistor\nchosen due to E-series"
		(exclude_from_sim no)
		(at 110.998 114.808 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "af1f3620-7ef0-422b-8a95-2c44817eba55")
	)
	(text "The datasheet mentions a\n10-100nF by-pass\ncapacitor near the Vcc\nand GND.\n\nThe 100nF capacitor\ntogether with the 22 ohm\nresistor form a low-pass filter\nwhich reduces power rail\noscillation caused by the oscillator."
		(exclude_from_sim no)
		(at 189.484 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c20fe972-1cee-4ea7-9686-d0208abf66e7")
	)
